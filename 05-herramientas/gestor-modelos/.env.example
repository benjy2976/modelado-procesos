# Plantilla versionada. Copiar a .env (ignorado por Git) y ajustar en cada equipo:
#   cp .env.example .env
# Compose lee .env automáticamente desde esta carpeta.

# Ruta al repositorio institucional; relativa a esta carpeta o absoluta.
PROCESOS_REPO_HOST=../..
# Puertos del anfitrión; elegir puertos libres. La API se publica solo en 127.0.0.1.
MODELOS_API_PORT=8766
MODELOS_UI_PORT=8767
# Interfaz donde se publica el frontend. 127.0.0.1 = solo este equipo.
# 0.0.0.0 = todas las interfaces (Tailscale y LAN); úsese solo detrás de un
# proxy inverso con control de acceso, porque la API no tiene autenticación.
# La API permanece siempre en 127.0.0.1.
MODELOS_UI_BIND=127.0.0.1
