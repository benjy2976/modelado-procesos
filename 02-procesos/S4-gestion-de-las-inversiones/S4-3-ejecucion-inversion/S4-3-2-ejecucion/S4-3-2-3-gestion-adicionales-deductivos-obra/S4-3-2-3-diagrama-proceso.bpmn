tion="None" /></bpmn:process><bpmn:process id="_5e48bdbf-9a5a-54e3-bc29-659fde6a775b" name="Supervisor o inspector de obra" isExecutable="false"><bpmn:laneSet id="_5e48bdbf-9a5a-54e3-bc29-659fde6a775b_ls"><bpmn:lane id="_132da46d-888c-5767-86fc-76dfead10c7f" name="Supervisor o inspector de obra, segun modalidad"><bpmn:flowNodeRef>_ec3261dc-4b60-5358-b254-9d6c67673e9c</bpmn:flowNodeRef><bpmn:flowNodeRef>_b8f8a374-b672-537e-84a9-78dad279d4f7</bpmn:flowNodeRef><bpmn:flowNodeRef>_e2d49bab-813f-5e3e-8a83-a548102013c1</bpmn:flowNodeRef><bpmn:flowNodeRef>_5ba556f6-935f-5ccf-b4ea-c04f9b1183ba</bpmn:flowNodeRef><bpmn:flowNodeRef>_20655219-4a82-5c68-8f0d-e6713838f6dc</bpmn:flowNodeRef><bpmn:flowNodeRef>_a086c77b-645c-55b8-b363-26d5a8701e3c</bpmn:flowNodeRef><bpmn:flowNodeRef>_2444cb94-4aa4-534c-8bc3-1cc2868d72a6</bpmn:flowNodeRef><bpmn:flowNodeRef>_7def99b4-58d1-5405-a94a-20225b6ffc0e</bpmn:flowNodeRef><bpmn:flowNodeRef>_6c01b57b-a2a4-5a63-b0d8-3cf7b0bcd24d</bpmn:flowNodeRef><bpmn:flowNodeRef>_2265c28e-b8b1-55dc-b6c7-9d26535ff089</bpmn:flowNodeRef><bpmn:flowNodeRef>_4a157aa6-359f-5d8b-949a-54a5bbfde879</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="_ec3261dc-4b60-5358-b254-9d6c67673e9c" name="Sustento del residente recibido"><bpmn:outgoing>_282ea412-680c-5271-9f0c-d881cd609703</bpmn:outgoing><bpmn:messageEventDefinition id="_ec3261dc-4b60-5358-b254-9d6c67673e9c_def" /></bpmn:startEvent><bpmn:startEvent id="_b8f8a374-b672-537e-84a9-78dad279d4f7" name="Necesidad identificada por supervision"><bpmn:outgoing>_cfce12b7-c475-5565-be68-8631bae1fe9b</bpmn:outgoing><bpmn:conditionalEventDefinition id="_b8f8a374-b672-537e-84a9-78dad279d4f7_def"><bpmn:condition xsi:type="bpmn:tFormalExpression">Necesidad identificada por supervision</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:startEvent><bpmn:userTask id="_e2d49bab-813f-5e3e-8a83-a548102013c1" name="Registrar la necesidad en el Cuaderno de Incidencias"><bpmn:incoming>_cfce12b7-c475-5565-be68-8631bae1fe9b</bpmn:incoming><bpmn:outgoing>_e380d424-1812-5316-a7cb-8f91eb466eef</bpmn:outgoing><bpmn:dataOutputAssociation id="_5443483d-e81c-5142-aa1c-7ae703c74032"><bpmn:targetRef>_ce16188a-1f7b-53d8-9721-c12d007e3b6c</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:exclusiveGateway id="_5ba556f6-935f-5ccf-b4ea-c04f9b1183ba" name=""><bpmn:incoming>_282ea412-680c-5271-9f0c-d881cd609703</bpmn:incoming><bpmn:incoming>_e380d424-1812-5316-a7cb-8f91eb466eef</bpmn:incoming><bpmn:outgoing>_7173bf20-7af0-5631-9756-6c19a44280ea</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="_20655219-4a82-5c68-8f0d-e6713838f6dc" name="Sustentar posicion tecnica sobre necesidad y riesgo"><bpmn:documentation>Informe a entidad en 5 dias desde el dia siguiente de la anotacion (art. 194.2 b)</bpmn:documentation><bpmn:incoming>_7173bf20-7af0-5631-9756-6c19a44280ea</bpmn:incoming><bpmn:outgoing>_2be9f1f9-ff28-5088-aab5-ecda9d73c2bb</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="_a086c77b-645c-55b8-b363-26d5a8701e3c" name="¿Ratifica la necesidad?"><bpmn:incoming>_2be9f1f9-ff28-5088-aab5-ecda9d73c2bb</bpmn:incoming><bpmn:outgoing>_aed23d7a-2aac-5888-83c3-22e8cf632ffa</bpmn:outgoing><bpmn:outgoing>_5908c8f4-47be-50a2-bceb-058ce8f3d845</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="_2444cb94-4aa4-534c-8bc3-1cc2868d72a6" name="Necesidad ratificada y remitida"><bpmn:incoming>_aed23d7a-2aac-5888-83c3-22e8cf632ffa</bpmn:incoming><bpmn:messageEventDefinition id="_2444cb94-4aa4-534c-8bc3-1cc2868d72a6_def" /></bpmn:endEvent><bpmn:endEvent id="_7def99b4-58d1-5405-a94a-20225b6ffc0e" name="Necesidad no ratificada"><bpmn:incoming>_5908c8f4-47be-50a2-bceb-058ce8f3d845</bpmn:incoming></bpmn:endEvent><bpmn:startEvent id="_6c01b57b-a2a4-5a63-b0d8-3cf7b0bcd24d" name="Expediente para evaluacion recibido"><bpmn:outgoing>_e655ca01-565d-5b20-a4c6-df5511a94ab6</bpmn:outgoing><bpmn:messageEventDefinition id="_6c01b57b-a2a4-5a63-b0d8-3cf7b0bcd24d_def" /></bpmn:startEvent><bpmn:task id="_2265c28e-b8b1-55dc-b6c7-9d26535ff089" name="Evaluar expediente ajeno y emitir opinion"><bpmn:documentation>Si elaboro contratista: 10 dias desde el dia siguiente de presentacion (art. 194.2 e); si elaboro entidad: plazo correspondiente por precisar</bpmn:documentation><bpmn:incoming>_e655ca01-565d-5b20-a4c6-df5511a94ab6</bpmn:incoming><bpmn:outgoing>_9f0f2625-d8f1-5396-9344-6b156978f0a1</bpmn:outgoing></bpmn:task><bpmn:endEvent id="_4a157aa6-359f-5d8b-949a-54a5bbfde879" name="Opinion de supervision remitida"><bpmn:incoming>_9f0f2625-d8f1-5396-9344-6b156978f0a1</bpmn:incoming><bpmn:messageEventDefinition id="_4a157aa6-359f-5d8b-949a-54a5bbfde879_def" /></bpmn:endEvent><bpmn:sequenceFlow id="_282ea412-680c-5271-9f0c-d881cd609703" name="" sourceRef="_ec3261dc-4b60-5358-b254-9d6c67673e9c" targetRef="_5ba556f6-935f-5ccf-b4ea-c04f9b1183ba" /><bpmn:sequenceFlow id="_cfce12b7-c475-5565-be68-8631bae1fe9b" name="" sourceRef="_b8f8a374-b672-537e-84a9-78dad279d4f7" targetRef="_e2d49bab-813f-5e3e-8a83-a548102013c1" /><bpmn:sequenceFlow id="_e380d424-1812-5316-a7cb-8f91eb466eef" name="" sourceRef="_e2d49bab-813f-5e3e-8a83-a548102013c1" targetRef="_5ba556f6-935f-5ccf-b4ea-c04f9b1183ba" /><bpmn:sequenceFlow id="_7173bf20-7af0-5631-9756-6c19a44280ea" name="" sourceRef="_5ba556f6-935f-5ccf-b4ea-c04f9b1183ba" targetRef="_20655219-4a82-5c68-8f0d-e6713838f6dc" /><bpmn:sequenceFlow id="_2be9f1f9-ff28-5088-aab5-ecda9d73c2bb" name="" sourceRef="_20655219-4a82-5c68-8f0d-e6713838f6dc" targetRef="_a086c77b-645c-55b8-b363-26d5a8701e3c" /><bpmn:sequenceFlow id="_aed23d7a-2aac-5888-83c3-22e8cf632ffa" name="Si" sourceRef="_a086c77b-645c-55b8-b363-26d5a8701e3c" targetRef="_2444cb94-4aa4-534c-8bc3-1cc2868d72a6" /><bpmn:sequenceFlow id="_5908c8f4-47be-50a2-bceb-058ce8f3d845" name="No" sourceRef="_a086c77b-645c-55b8-b363-26d5a8701e3c" targetRef="_7def99b4-58d1-5405-a94a-20225b6ffc0e" /><bpmn:sequenceFlow id="_e655ca01-565d-5b20-a4c6-df5511a94ab6" name="" sourceRef="_6c01b57b-a2a4-5a63-b0d8-3cf7b0bcd24d" targetRef="_2265c28e-b8b1-55dc-b6c7-9d26535ff089" /><bpmn:sequenceFlow id="_9f0f2625-d8f1-5396-9344-6b156978f0a1" name="" sourceRef="_2265c28e-b8b1-55dc-b6c7-9d26535ff089" targetRef="_4a157aa6-359f-5d8b-949a-54a5bbfde879" /><bpmn:dataObject id="_ce16188a-1f7b-53d8-9721-c12d007e3b6c_do" /><bpmn:dataObjectReference id="_ce16188a-1f7b-53d8-9721-c12d007e3b6c" name="Registro de necesidad" dataObjectRef="_ce16188a-1f7b-53d8-9721-c12d007e3b6c_do" /><bpmn:textAnnotation id="_b64e268d-aa0b-5ee4-ab70-dc7875114a57"><bpmn:text>Origen alternativo del art. 194; consulta previa si existe. No duplicar anotacion ya valida</bpmn:text></bpmn:textAnnotation><bpmn:association id="_8781676a-bbc4-597f-b524-63b3f57d75c8" sourceRef="_b8f8a374-b672-537e-84a9-78dad279d4f7" targetRef="_b64e268d-aa0b-5ee4-ab70-dc7875114a57" associationDirection="None" /><bpmn:textAnnotation id="_982ebb47-6806-512b-815e-e375c301693c"><bpmn:text>Comunicar anotacion al elaborador definido en bases; inicia computo sin esperar ratificacion</bpmn:text></bpmn:textAnnotation><bpmn:association id="_0dbd4c8d-69af-57cc-bb99-55ca4e5a5e97" sourceRef="_e2d49bab-813f-5e3e-8a83-a548102013c1" targetRef="_982ebb47-6806-512b-815e-e375c301693c" associationDirection="None" /><bpmn:textAnnotation id="_a9a1f441-02dc-5c5e-9f80-370ca1214f43"><bpmn:text>Convergencia exclusiva: residente o supervision. No aprueba ni espera ambos origenes</bpmn:text></bpmn:textAnnotation><bpmn:association id="_52525558-5e70-5759-bdd8-d2f459e89d4d" sourceRef="_5ba556f6-935f-5ccf-b4ea-c04f9b1183ba" targetRef="_a9a1f441-02dc-5c5e-9f80-370ca1214f43" associationDirection="None" /><bpmn:textAnnotation id="_c9e73835-7737-5ed8-8969-007fefb2687d"><bpmn:text>El informe fundamenta si ratifica o no; no extender este plazo a reducciones ni administracion directa</bpmn:text></bpmn:textAnnotation><bpmn:association id="_a395d617-9559-526a-9734-e1c49fc76607" sourceRef="_20655219-4a82-5c68-8f0d-e6713838f6dc" targetRef="_c9e73835-7737-5ed8-8969-007fefb2687d" associationDirection="None" /><bpmn:textAnnotation id="_2b9fb964-391f-57f3-902f-929ae8106f27"><bpmn:text>Supervisor opina cuando elaboro contratista o entidad; no revisa expediente elaborado por el mismo</bpmn:text></bpmn:textAnnotation><bpmn:association id="_368a4647-6679-5905-83b3-2169ef329a71" sourceRef="_2265c28e-b8b1-55dc-b6c7-9d26535ff089" targetRef="_2b9fb964-391f-57f3-902f-929ae8106f27" associationDirection="None" /></bpmn:process><bpmn:process id="_0fa67bd5-e61d-5a9b-ab5c-fa0d97f5017c" name="Gobierno Regional Huanuco" isExecutable="false"><bpmn:laneSet id="_0fa67bd5-e61d-5a9b-ab5c-fa0d97f5017c_ls"><bpmn:lane id="_05b8f063-bb7f-5e1e-a8c1-f952a1741ba1" name="OACGD — Registro documentario"><bpmn:flowNodeRef>_e8e94572-a6fc-54ce-b272-8879f36240ec</bpmn:flowNodeRef><bpmn:flowNodeRef>_aaa3d8e8-9d5e-5412-8828-ef92a34917ef</bpmn:flowNodeRef><bpmn:flowNodeRef>_936f965d-cb75-5dd0-a912-7bf52dce6728</bpmn:flowNodeRef><bpmn:flowNodeRef>_7e9e8f88-2e4d-5ea5-b7f8-e8a26c2b0ce1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="_e900e638-a03d-5cdb-9694-cb9d9c1c0c00" name="SGGOS — Subgerente de Gestion de Obras y Supervision"><bpmn:flowNodeRef>_542911e8-96ab-5e9b-ace1-4a41b6f6d623</bpmn:flowNodeRef><bpmn:flowNodeRef>_d9af7ade-a327-50b4-94dc-1f9ca0a8211e</bpmn:flowNodeRef><bpmn:flowNodeRef>_47743d37-1760-5a09-94fd-f87440efc325</bpmn:flowNodeRef><bpmn:flowNodeRef>_47696590-3470-563a-85e2-40180588850a</bpmn:flowNodeRef><bpmn:flowNodeRef>_27eb1edb-d823-5a5c-8831-a0e774a20b21</bpmn:flowNodeRef><bpmn:flowNodeRef>_d0a471c4-4b1e-55dc-b4de-79d2d480c06b</bpmn:flowNodeRef><bpmn:flowNodeRef>_4a219622-51b2-58ba-93f0-74e7c4147518</bpmn:flowNodeRef><bpmn:flowNodeRef>_e3e5efca-6395-5bae-8fb0-c4678c249db2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="_a6a02131-f027-584b-91fe-64f074a32cc1" name="SGGOS — Coordinador de obra"><bpmn:flowNodeRef>_802be49d-7fe6-53bf-a9c9-de0f05d23993</bpmn:flowNodeRef><bpmn:flowNodeRef>_99b9df6a-1ae9-5985-ba38-547a238238b8</bpmn:flowNodeRef><bpmn:flowNodeRef>_116ec1a7-8353-572e-9b91-d7b7c5