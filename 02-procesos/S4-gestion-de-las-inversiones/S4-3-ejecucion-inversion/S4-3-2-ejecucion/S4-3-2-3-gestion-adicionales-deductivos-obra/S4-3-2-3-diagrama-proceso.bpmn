argetRef="_8d33aa1e-8527-5bcd-989b-55a1bfe2a6f6" /><bpmn:sequenceFlow id="_3e74c71e-446c-5b5a-9021-57d347739e3e" name="Contratista o entidad" sourceRef="_35269f93-dfcf-5513-9746-4a3836920a38" targetRef="_2948bc6a-3530-5c1f-b4e4-e8d513d038a8" /><bpmn:sequenceFlow id="_ca219970-3a7a-510d-a546-96280d08194f" name="Siempre: verificar opinion previa" sourceRef="_35269f93-dfcf-5513-9746-4a3836920a38" targetRef="_c8303242-dd06-5e50-aa5f-26103857ff76" /><bpmn:sequenceFlow id="_d10f8bde-2cd8-55ac-9cbb-dea842ddca97" name="" sourceRef="_2948bc6a-3530-5c1f-b4e4-e8d513d038a8" targetRef="_bdb536cb-480c-5afa-8b5d-578fa9be857b" /><bpmn:sequenceFlow id="_82a4f7da-a8ae-5ae2-8d9a-559587299137" name="" sourceRef="_bdb536cb-480c-5afa-8b5d-578fa9be857b" targetRef="_3d1701ee-e8cb-5f17-aa18-6ac2bda23580" /><bpmn:sequenceFlow id="_c3ef6326-ef68-5db8-ab41-a1019b4a737f" name="" sourceRef="_3d1701ee-e8cb-5f17-aa18-6ac2bda23580" targetRef="_ff79381a-6a62-54aa-b484-e13a05002957" /><bpmn:sequenceFlow id="_77e5510e-fcb0-5804-8156-ed3660a4cb08" name="Si" sourceRef="_0a2984ba-0fd6-5450-86f5-81de9444423a" targetRef="_b8087164-4d6a-5c93-aae8-1d1c5839d432" /><bpmn:sequenceFlow id="_2e105a63-fa12-5fdf-b244-c289ed7ee8f2" name="No" sourceRef="_0a2984ba-0fd6-5450-86f5-81de9444423a" targetRef="_fcfd28d2-5270-5b11-9c69-2d79bc48d540" /><bpmn:sequenceFlow id="_d4c8f290-e3f7-5f40-80ca-ee4b70ce713c" name="" sourceRef="_b8087164-4d6a-5c93-aae8-1d1c5839d432" targetRef="_e1699274-b477-5318-b38d-2121bdb40e70" /><bpmn:sequenceFlow id="_8fab752d-85e9-569f-b952-2912fca6e287" name="" sourceRef="_e1699274-b477-5318-b38d-2121bdb40e70" targetRef="_3d1701ee-e8cb-5f17-aa18-6ac2bda23580" /><bpmn:sequenceFlow id="_4f5c2c2d-a847-5a33-92b5-4a3c4e864941" name="Si" sourceRef="_fcfd28d2-5270-5b11-9c69-2d79bc48d540" targetRef="_57527f3d-27cf-52c1-ac6e-024b4a95d8a0" /><bpmn:sequenceFlow id="_f0df8b68-45c8-50ea-8655-40414065c63c" name="No" sourceRef="_fcfd28d2-5270-5b11-9c69-2d79bc48d540" targetRef="_fe46d619-516e-54d5-a2d6-2d614d304235" /><bpmn:sequenceFlow id="_9150222b-8cf3-5c96-ae91-dc6356f7c48a" name="" sourceRef="_57527f3d-27cf-52c1-ac6e-024b4a95d8a0" targetRef="_3d1701ee-e8cb-5f17-aa18-6ac2bda23580" /><bpmn:sequenceFlow id="_d7709c87-ba3e-5808-8dc7-c56d0943375e" name="" sourceRef="_7e9e8f88-2e4d-5ea5-b7f8-e8a26c2b0ce1" targetRef="_aaa3d8e8-9d5e-5412-8828-ef92a34917ef" /><bpmn:sequenceFlow id="_4aa79fc4-c51d-5fdf-a42a-6fedcd7f9185" name="" sourceRef="_1545e48a-a4b4-5312-9686-69179069f98d" targetRef="_18faa997-7652-5102-a9b4-88f5881b4433" /><bpmn:sequenceFlow id="_c1a9922b-b245-53d4-a68c-0cccc58a822f" name="" sourceRef="_226ae10e-f4a1-5f66-b878-d47a09871d50" targetRef="_1bc2cf6d-1b00-5e92-982b-0a99d281203f" /><bpmn:sequenceFlow id="_6cef3066-745d-5113-91dc-4a48a6231369" name="Si" sourceRef="_1bc2cf6d-1b00-5e92-982b-0a99d281203f" targetRef="_16d58df4-023e-51c5-9401-dcc85ee27dba" /><bpmn:sequenceFlow id="_05f57143-2083-50a5-ac0e-352ad01af179" name="No o no acreditado" sourceRef="_1bc2cf6d-1b00-5e92-982b-0a99d281203f" targetRef="_8d33aa1e-8527-5bcd-989b-55a1bfe2a6f6" /><bpmn:dataObject id="_2250a641-d550-5d72-a0bb-3812a05f154e_do" /><bpmn:dataObjectReference id="_2250a641-d550-5d72-a0bb-3812a05f154e" name="Registro y derivacion" dataObjectRef="_2250a641-d550-5d72-a0bb-3812a05f154e_do" /><bpmn:dataStoreReference id="_884c100e-eba5-5ee7-86ab-705738922e80" name="SGD" dataStoreRef="_6bcd92d4-a753-5d61-ba7a-4b1917dbd405" /><bpmn:dataObject id="_15a11ee8-b5f8-5312-982f-7279f6bd0455_do" /><bpmn:dataObjectReference id="_15a11ee8-b5f8-5312-982f-7279f6bd0455" name="Expediente" dataObjectRef="_15a11ee8-b5f8-5312-982f-7279f6bd0455_do" /><bpmn:dataObject id="_e4ca9d57-304f-5fee-ba69-09cf0a252e9b_do" /><bpmn:dataObjectReference id="_e4ca9d57-304f-5fee-ba69-09cf0a252e9b" name="Comunicacion" dataObjectRef="_e4ca9d57-304f-5fee-ba69-09cf0a252e9b_do" /><bpmn:dataObject id="_44b9dc4f-7923-5bf8-b065-ed7f3b2e85e5_do" /><bpmn:dataObjectReference id="_44b9dc4f-7923-5bf8-b065-ed7f3b2e85e5" name="Opinion tecnica" dataObjectRef="_44b9dc4f-7923-5bf8-b065-ed7f3b2e85e5_do" /><bpmn:dataObject id="_df65c24d-2e19-5960-b5cc-7b2c2b6f4763_do" /><bpmn:dataObjectReference id="_df65c24d-2e19-5960-b5cc-7b2c2b6f4763" name="Observaciones tecnicas" dataObjectRef="_df65c24d-2e19-5960-b5cc-7b2c2b6f4763_do" /><bpmn:dataObject id="_11b23a00-08d7-5f75-a23f-39e89d9c9ee9_do" /><bpmn:dataObjectReference id="_11b23a00-08d7-5f75-a23f-39e89d9c9ee9" name="Control contractual y de costos" dataObjectRef="_11b23a00-08d7-5f75-a23f-39e89d9c9ee9_do" /><bpmn:dataObject id="_f4e61aef-3bf6-54ba-8eed-f29de9044e86_do" /><bpmn:dataObjectReference id="_f4e61aef-3bf6-54ba-8eed-f29de9044e86" name="Control presupuestal" dataObjectRef="_f4e61aef-3bf6-54ba-8eed-f29de9044e86_do" /><bpmn:dataObject id="_bff05188-c736-5dbd-b9d9-e9ef66dd9ac4_do" /><bpmn:dataObjectReference id="_bff05188-c736-5dbd-b9d9-e9ef66dd9ac4" name="Control juridico" dataObjectRef="_bff05188-c736-5dbd-b9d9-e9ef66dd9ac4_do" /><bpmn:dataObject id="_425b41f3-f4a8-54eb-bed9-f14d20ff5597_do" /><bpmn:dataObjectReference id="_425b41f3-f4a8-54eb-bed9-f14d20ff5597" name="Expediente consolidado" dataObjectRef="_425b41f3-f4a8-54eb-bed9-f14d20ff5597_do" /><bpmn:dataObject id="_bccbee55-f1fb-52cd-b810-2bebd0bf651e_do" /><bpmn:dataObjectReference id="_bccbee55-f1fb-52cd-b810-2bebd0bf651e" name="Solicitud de autorizacion" dataObjectRef="_bccbee55-f1fb-52cd-b810-2bebd0bf651e_do" /><bpmn:dataObject id="_9b527081-6502-5366-96db-51f01d56fca9_do" /><bpmn:dataObjectReference id="_9b527081-6502-5366-96db-51f01d56fca9" name="Expediente consolidado" dataObjectRef="_9b527081-6502-5366-96db-51f01d56fca9_do" /><bpmn:dataObject id="_994189d2-fd41-5037-8085-e8078dadbfe5_do" /><bpmn:dataObjectReference id="_994189d2-fd41-5037-8085-e8078dadbfe5" name="Pronunciamiento" dataObjectRef="_994189d2-fd41-5037-8085-e8078dadbfe5_do" /><bpmn:dataObject id="_b5e9eb20-d5dc-5713-a778-412082ab16a8_do" /><bpmn:dataObjectReference id="_b5e9eb20-d5dc-5713-a778-412082ab16a8" name="Registros y comunicacion" dataObjectRef="_b5e9eb20-d5dc-5713-a778-412082ab16a8_do" /><bpmn:textAnnotation id="_8befbfa7-0128-5314-935e-6df9567b1b40"><bpmn:text>Si requiere juicio tecnico especializado, deriva al especialista competente</bpmn:text></bpmn:textAnnotation><bpmn:association id="_62c97f70-739e-5cf1-b1f0-85af4c025af9" sourceRef="_99b9df6a-1ae9-5985-ba38-547a238238b8" targetRef="_8befbfa7-0128-5314-935e-6df9567b1b40" associationDirection="None" /><bpmn:textAnnotation id="_f7a2e784-c3fe-5e78-9fb9-b6c58eccd662"><bpmn:text>Reducciones: S4.3.2.7; mayores metrados: S4.3.2.8. No aprueba la figura derivada</bpmn:text></bpmn:textAnnotation><bpmn:association id="_1bd9fd3c-b46d-5306-8be0-6d86c3fa1c85" sourceRef="_d9af7ade-a327-50b4-94dc-1f9ca0a8211e" targetRef="_f7a2e784-c3fe-5e78-9fb9-b6c58eccd662" associationDirection="None" /><bpmn:textAnnotation id="_ecdc0091-4b37-54d4-9986-de5001116123"><bpmn:text>Causal indispensable; anotacion e informe; confirmar elaborador segun bases y evitar duplicar el encargo de consultas</bpmn:text></bpmn:textAnnotation><bpmn:association id="_a8566aff-2872-5444-8cb6-aad630afb804" sourceRef="_18faa997-7652-5102-a9b4-88f5881b4433" targetRef="_ecdc0091-4b37-54d4-9986-de5001116123" associationDirection="None" /><bpmn:textAnnotation id="_341ee99c-0f86-5613-9935-8e1baa8bb4eb"><bpmn:text>No reinicia los 15 dias; encargo segun bases y antecedente de consulta</bpmn:text></bpmn:textAnnotation><bpmn:association id="_6ba28acf-baa3-50b8-a884-3efb33d553ce" sourceRef="_47743d37-1760-5a09-94fd-f87440efc325" targetRef="_341ee99c-0f86-5613-9935-8e1baa8bb4eb" associationDirection="None" /><bpmn:textAnnotation id="_89e008f4-ed07-5153-bfbb-9a2c2ecddff4"><bpmn:text>Proyectista en primera instancia si no transcurrio mas de un anio; en defecto organo competente</bpmn:text></bpmn:textAnnotation><bpmn:association id="_058845ef-4803-55de-8dfc-ccc22afe6081" sourceRef="_c8303242-dd06-5e50-aa5f-26103857ff76" targetRef="_89e008f4-ed07-5153-bfbb-9a2c2ecddff4" associationDirection="None" /><bpmn:textAnnotation id="_dd112170-b0b2-5838-9e33-3c994e7063ea"><bpmn:text>Resultado desfavorable tambien se eleva para decision; no terminar solo en opinion</bpmn:text></bpmn:textAnnotation><bpmn:association id="_9f0d9af3-7af9-5509-bef6-fbc1e0507ff4" sourceRef="_ff79381a-6a62-54aa-b484-e13a05002957" targetRef="_dd112170-b0b2-5838-9e33-3c994e7063ea" associationDirection="None" /><bpmn:textAnnotation id="_9f00fd3c-30d6-591b-9cf3-5d19d93bf970"><bpmn:text>Subsanacion y efecto sobre plazos pendientes; no se reinicia automaticamente el plazo normativo</bpmn:text></bpmn:textAnnotation><bpmn:association id="_461b0745-8ae5-5b17-a8ce-f0903796a819" sourceRef="_27636f70-c417-5099-9bc3-9d2b438e8704" targetRef="_9f00fd3c-30d6-591b-9cf3-5d19d93bf970" associationDirection="None" /><bpmn:textAnnotation id="_29780043-56df-5916-8a12-319a90c7d5a0"><bpmn:text>C siempre; P y J segun figura. Controles no amplian el plazo legal</bpmn:text></bpmn:textAnnotation><bpmn:association id="_4a3dcb1f-fbdc-5eb6-87f0-cd411f3e611e" sourceRef="_9a5fa4d3-1303-5581-8f43-db767227d858" targetRef="_29780043-56df-5916-8a12-319a90c7d5a0" associationDirection="None" /><bpmn:textAnnotation id="_da63d3b6-bb81-5ea0-ab3c-ad0679d79097"><bpmn:text>No descontar una reduccion independiente como deductivo vinculado sin sustento</bpmn:text></bpmn:textAnnotation><bpmn:association id="_9e2b4fe4-6e76-5337-ad13-86a144bdaf37" sourceRef="_242b206c-284c-5b4a-a02e-f92eadf57e05" targetRef="_da63d3b6-bb81-5ea0-ab3c-ad0679d79097" associationDirection="None" /><bpmn:textAnnotation id="_338ee901-87c3-577e-b5ba-10d2910a68be"><bpmn:text>Reduccion independiente no sigue esta rama; verificar autoridad y umbral del adicional</bpmn:text></bpmn:textAnnotation><bpmn:association id="_5f91e8a5-0347-51c6-a849-78a8ed28e6af" sourceRef="_b1f8b5a5-2dc0-5153-9676-2a5e8c4ca631" targetRef="_338ee901-87c3-577e-b5ba-10d2910a68be" associationDirection="None" /><bpmn:textAnnotation id="_7339d0b7-36dd-5386-9e8a-2a432dd1c1d7"><bpmn:text>Unidad remitente interna pendiente de confirmar</bpmn:text></bpmn:textAnnotation><bpmn:association id="_70075b34-4e47-5210-a73b-b262e7a5bb42" sourceRef="_6ca8fc4c-7efa-5400-a671-e6c90443ee8d" targetRef="_7339d0b7-36dd-5386-9e8a-2a432dd1c1d7" associationDirection="None" /><bpmn:textAnnotation id="_2318806a-eb0e-5482-874f-ce1b0a493d5e"><bpmn:text>12 dias habiles del tramite institucional, desde dia siguiente de opinion del supervisor o expediente elaborado por este; no aplica a reduccion</bpmn:text></bpmn:textAnnotation><bpmn:association id="_7b179219-cd17-50b2-82bb-4b75742ba9d5" sourceRef="_064e1416-8c1d-5c4c-a757-98221d898d84" targetRef="_2318806a-eb0e-5482-874f-ce1b0a493d5e" associationDirection="None" /><bpmn:textAnnotation id="_058184db-805c-5e79-bd4b-34dba5187975"><bpmn:text>Verificar canal vigente SEACE/Pladicop o transitorio contractual; no presumir implementacion actual</bpmn:text></bpmn:textAnnotation><bpmn:association id="_6eb84a09-6ff2-584b-b488-08dfa3d1afcf" sourceRef="_918cb9df-5021-58c7-8a42-d3c3b0ada77f" targetRef="_058184db-805c-5e79-bd4b-34dba5187975" associationDirection="None" /><bpmn:textAnnotation id="_ed7bed3d-279b-5a15-a97a-5876ae522c89"><bpmn:text>EVIDENCIA-INSUFICIENTE; no es aprobacion ni denegacion de fondo</bpmn:text></bpmn:textAnnotation><bpmn:association id="_087ed6b8-ebdb-503b-b3d4-71576d471143" sourceRef="_8d33aa1e-8527-5bcd-989b-55a1bfe2a6f6" targetRef="_ed7bed3d-279b-5a15-a97a-5876ae522c89" associationDirection="None" /><bpmn:textAnnotation id="_0dc1720f-4ed0-531c-a678-fe93fef9360d"><bpmn:text>No imponer al supervisor diez dias para revisar su propio expediente</bpmn:text></bpmn:textAnnotation><bpmn:association id="_3ab88015-800d-5e8a-b300-85c4cd0e3580" sourceRef="_6ea5a5b6-e50b-58e6-9b8a-24a284ddc142" targetRef="_0dc1720f-4ed0-531c-a678-fe93fef9360d" associationDirection="None" /><bpmn:textAnnotation id="_b2e92470-b6f0-5a8e-802e-36b276f8f5fe"><bpmn:text>Seleccion por elaborador; cuando es contratista, ambas opiniones tienen el mismo plazo</bpmn:text></bpmn:textAnnotation><bpmn:association id="_bc25744d-c018-55d9-aee3-6cbd3151fc43" sourceRef="_35269f93-dfcf-5513-9746-4a3836920a38" targetRef="_b2e92470-b6f0-5a8e-802e-36b276f8f5fe" associationDirection="None" /><bpmn:textAnnotation id="_38c86b1b-9216-569e-9ec0-1ef6a18c75de"><bpmn:text>Presentacion a entidad y supervision cuando elabora contratista; si elabora entidad, remite al supervisor</bpmn:text></bpmn:textAnnotation><bpmn:association id="_c90036cb-140e-5462-984f-c91979e98ade" sourceRef="_2948bc6a-3530-5c1f-b4e4-e8d513d038a8" targetRef="_38c86b1b-9216-569e-9ec0-1ef6a18c75de" associationDirection="None" /><bpmn:textAnnotation id="_fce3d912-7a41-51a0-a4ca-c8b16ef22c4a"><bpmn:text>Reune opiniones activadas segun elaborador; no abre un nuevo plazo</bpmn:text></bpmn:textAnnotation><bpmn:association id="_77850dcd-ac43-5154-8a40-b702ffda13fb" sourceRef="_3d1701ee-e8cb-5f17-aa18-6ac2bda23580" targetRef="_fce3d912-7a41-51a0-a4ca-c8b16ef22c4a" associationDirection="None" /><bpmn:textAnnotation id="_8a26a2c3-7a28-5502-9dec-128d26407bb1"><bpmn:text>No mas de un anio desde conformidad del expediente original</bpmn:text></bpmn:textAnnotation><bpmn:association id="_dd6cb4e6-0d29-58fc-aee4-d6dd18425d3a" sourceRef="_0a2984ba-0fd6-5450-86f5-81de9444423a" targetRef="_8a26a2c3-7a28-5502-9dec-128d26407bb1" associationDirection="None" /><bpmn:textAnnotation id="_0f9588e3-3c19-57ec-8f66-0385e17b8f6e"><bpmn:text>No auto-revisar: supuesto 2.8; conservar supervision. Controles independientes de DEC-038 segun riesgo</bpmn:text></bpmn:textAnnotation><bpmn:association id="_15e13633-59af-5cbb-8d58-4fd5118ed4df" sourceRef="_57527f3d-27cf-52c1-ac6e-024b4a95d8a0" targetRef="_0f9588e3-3c19-57ec-8f66-0385e17b8f6e" associationDirection="None" /><bpmn:textAnnotation id="_d370107f-e774-51a2-bbe1-226f1e605a75"><bpmn:text>Evaluacion conjunta; acreditar vinculo de sustitucion. No restar reducciones independientes</bpmn:text></bpmn:textAnnotation><bpmn:association id="_d0eec14c-7713-5723-bbeb-e58f256a8d61" sourceRef="_1545e48a-a4b4-5312-9686-69179069f98d" targetRef="_d370107f-e774-51a2-bbe1-226f1e605a75" associationDirection="None" /><bpmn:textAnnotation id="_58574aa7-0ea5-5ec2-88ec-019af5cee3f2"><bpmn:text>EVIDENCIA-INSUFICIENTE sobre ruta autonoma; no aplicar plazos 15 y 10 por analogia</bpmn:text></bpmn:textAnnotation><bpmn:association id="_7e804a68-fef8-5f65-9eea-f6c5808790e3" sourceRef="_226ae10e-f4a1-5f66-b878-d47a09871d50" targetRef="_58574aa7-0ea5-5ec2-88ec-019af5cee3f2" associationDirection="None" /></bpmn:process><bpmn:process id="_437ce641-6a41-513b-a8d5-27b7a649454f" name="Elaboracion del expediente tecnico" isExecutable="false"><bpmn:laneSet id="_437ce641-6a41-513b-a8d5-27b7a649454f_ls"><bpmn:lane id="_a9766380-1af3-5618-be74-09e8f3d2d7be" name="Equipo elaborador competente (adscripcion pendiente)"><bpmn:flowNodeRef>_f5a7c301-0db0-5843-b42d-766109535934</bpmn:flowNodeRef><bpmn:flowNodeRef>_71ba4135-6354-55e7-a4f3-b46394650abb</bpmn:flowNodeRef><bpmn:flowNodeRef>_8fbfb8c8-912d-5fa1-bcfe-4d874e335438</bpmn:flowNodeRef><bpmn:flowNodeRef>_576cff86-1fcc-586d-9c55-de4ce2e8fd69</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="_f5a7c301-0db0-5843-b42d-766109535934" name="Anotacion y antecedentes recibidos"><bpmn:outgoing>_3fcbca34-3f5e-5aa5-9106-a642ffe03025</bpmn:outgoing><bpmn:messageEventDefinition id="_f5a7c301-0db0-5843-b42d-766109535934_def" /></bpmn:startEvent><bpmn:userTask id="_71ba4135-6354-55e7-a4f3-b46394650abb" name="Elaborar expediente del adicional y deductivo vinculado"><bpmn:documentation>15 dias calendario desde el dia siguiente de la anotacion; necesidad ratificada</bpmn:documentation><bpmn:incoming>_3fcbca34-3f5e-5aa5-9106-a642ffe03025</bpmn:incoming><bpmn:outgoing>_5e40c4c8-fee9-5396-8fc0-1a192975a5d8</bpmn:outgoing><bpmn:dataOutputAssociation id="_847e55d0-ed33-5d3e-a7f4-1da24dabf363"><bpmn:targetRef>_a1bf5851-7f42-53e1-aa5d-d581848fad88</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:endEvent id="_8fbfb8c8-912d-5fa1-bcfe-4d874e335438" name="Expediente tecnico presentado"><bpmn:incoming>_e90f51b6-7e75-53f4-b67f-1bb88e5e4f6e</bpmn:incoming><bpmn:messageEventDefinition id="_8fbfb8c8-912d-5fa1-bcfe-4d874e335438_def" /></bpmn:endEvent><bpmn:intermediateCatchEvent id="_576cff86-1fcc-586d-9c55-de4ce2e8fd69" name="Ratificacion comunicada para presentar"><bpmn:incoming>_5e40c4c8-fee9-5396-8fc0-1a192975a5d8</bpmn:incoming><bpmn:outgoing>_e90f51b6-7e75-53f4-b67f-1bb88e5e4f6e</bpmn:outgoing><bpmn:messageEventDefinition id="_576cff86-1fcc-586d-9c55-de4ce2e8fd69_def" /></bpmn:intermediateCatchEvent><bpmn:sequenceFlow id="_3fcbca34-3f5e-5aa5-9106-a642ffe03025" name="" sourceRef="_f5a7c301-0db0-5843-b42d-766109535934" targetRef="_71ba4135-6354-55e7-a4f3-b46394650abb" /><bpmn:sequenceFlow id="_5e40c4c8-fee9-5396-8fc0-1a192975a5d8" name="" sourceRef="_71ba4135-6354-55e7-a4f3-b46394650abb" targetRef="_576cff86-1fcc-586d-9c55-de4ce2e8fd69" /><bpmn:sequenceFlow id="_e90f51b6-7e75-53f4-b67f-1bb88e5e4f6e" name="" sourceRef="_576cff86-1fcc-586d-9c55-de4ce2e8fd69" targetRef="_8fbfb8c8-912d-5fa1-bcfe-4d874e335438" /><bpmn:dataObject id="_a1bf5851-7f42-53e1-aa5d-d581848fad88_do" /><bpmn:dataObjectReference id="_a1bf5851-7f42-53e1-aa5d-d581848fad88" name="Expediente tecnico" dataObjectRef="_a1bf5851-7f42-53e1-aa5d-d581848fad88_do" /><bpmn:textAnnotation id="_c2f5f425-7f59-5d78-b102-f23b6a363057"><bpmn:text>Elaboracion dentro del computo iniciado; presentacion condicionada a ratificacion; plazo adicional solo otorgado con sustento</bpmn:text></bpmn:textAnnotation><bpmn:association id="_6ef3e03a-9beb-5da1-ab29-0ae224438d5b" sourceRef="_71ba4135-6354-55e7-a4f3-b46394650abb" targetRef="_c2f5f425-7f59-5d78-b102-f23b6a363057" associationDirection="None" /><bpmn:textAnnotation id="_8a835216-f07b-5d4e-9c75-0104e0fedd20"><bpmn:text>Condicion de presentacion; no nuevo inicio del computo</bpmn:text></bpmn:textAnnotation><bpmn:association id="_cfc767ff-8b94-5924-ae3b-9d50b82b45fe" sourceRef="_576cff86-1fcc-586d-9c55-de4ce2e8fd69" targetRef="_8a835216-f07b-5d4e-9c75-0104e0fedd20" associationDirection="None" /></bpmn:process><bpmndi:BPMNDiagram id="Diag_fb37fe53" name="S4.3.2.3 Gestion de adicionales y deductivos de obra"><bpmndi:BPMNPlane id="Plane_fb37fe53" bpmnElement="Collab_fb37fe53"><bpmndi:BPMNShape id="_208bbe10-b54a-5ff8-a185-164ff6f045fe_di" bpmnElement="_208bbe10-b54a-5ff8-a185-164ff6f045fe" isHorizontal="true"><dc:Bounds x="20" y="216" width="602" height="302" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_d66ce823-25d3-5704-be05-4d325daea3ae_di" bpmnElement="_d66ce823-25d3-5704-be05-4d325daea3ae" isHorizontal="true"><dc:Bounds x="20" y="614" width="1654" height="447" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_6c53df70-4ffe-5bec-925c-f9286e6a5d82_di" bpmnElement="_6c53df70-4ffe-5bec-925c-f9286e6a5d82" isHorizontal="true"><dc:Bounds x="20" y="1157" width="2760" height="6787" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_3160fab9-a325-5ac0-aa65-66bc5b9464df_di" bpmnElement="_3160fab9-a325-5ac0-aa65-66bc5b9464df" isHorizontal="true"><dc:Bounds x="20" y="8040" width="768" height="330" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_99bc4fc0-0acd-55d6-8cbf-6163302d1418_di" bpmnElement="_99bc4fc0-0acd-55d6-8cbf-6163302d1418" isHorizontal="true"><dc:Bounds x="573" y="40" width="316" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_b5ebcf96-e87a-5d2e-9c62-cf91546fa5df_di" bpmnElement="_b5ebcf96-e87a-5d2e-9c62-cf91546fa5df" isHorizontal="true"><dc:Bounds x="20" y="40" width="326" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_53d80dad-8596-5bb5-b53f-75617d99dd3b_di" bpmnElement="_53d80dad-8596-5bb5-b53f-75617d99dd3b" isHorizontal="true"><dc:Bounds x="2399" y="40" width="316" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_158c779e-8137-5989-8c86-e88d7d656945_di" bpmnElement="_158c779e-8137-5989-8c86-e88d7d656945" isHorizontal="true"><dc:Bounds x="1616" y="8451" width="389" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_2c7b0c4c-f27c-5f1e-