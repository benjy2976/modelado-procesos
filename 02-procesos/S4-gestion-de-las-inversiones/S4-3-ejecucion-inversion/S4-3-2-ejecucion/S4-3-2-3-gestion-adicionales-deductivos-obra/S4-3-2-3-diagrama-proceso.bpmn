rceRef="_b8f8a374-b672-537e-84a9-78dad279d4f7" targetRef="_b64e268d-aa0b-5ee4-ab70-dc7875114a57" associationDirection="None" /><bpmn:textAnnotation id="_982ebb47-6806-512b-815e-e375c301693c"><bpmn:text>Comunicar anotacion al elaborador definido en bases; inicia computo sin esperar ratificacion</bpmn:text></bpmn:textAnnotation><bpmn:association id="_0dbd4c8d-69af-57cc-bb99-55ca4e5a5e97" sourceRef="_e2d49bab-813f-5e3e-8a83-a548102013c1" targetRef="_982ebb47-6806-512b-815e-e375c301693c" associationDirection="None" /><bpmn:textAnnotation id="_a9a1f441-02dc-5c5e-9f80-370ca1214f43"><bpmn:text>Convergencia exclusiva: residente o supervision. No aprueba ni espera ambos origenes</bpmn:text></bpmn:textAnnotation><bpmn:association id="_52525558-5e70-5759-bdd8-d2f459e89d4d" sourceRef="_5ba556f6-935f-5ccf-b4ea-c04f9b1183ba" targetRef="_a9a1f441-02dc-5c5e-9f80-370ca1214f43" associationDirection="None" /><bpmn:textAnnotation id="_c9e73835-7737-5ed8-8969-007fefb2687d"><bpmn:text>No extender este plazo a reducciones ni administracion directa</bpmn:text></bpmn:textAnnotation><bpmn:association id="_a395d617-9559-526a-9734-e1c49fc76607" sourceRef="_20655219-4a82-5c68-8f0d-e6713838f6dc" targetRef="_c9e73835-7737-5ed8-8969-007fefb2687d" associationDirection="None" /><bpmn:textAnnotation id="_2b9fb964-391f-57f3-902f-929ae8106f27"><bpmn:text>No se omite pronunciamiento por elaboracion de entidad</bpmn:text></bpmn:textAnnotation><bpmn:association id="_368a4647-6679-5905-83b3-2169ef329a71" sourceRef="_2265c28e-b8b1-55dc-b6c7-9d26535ff089" targetRef="_2b9fb964-391f-57f3-902f-929ae8106f27" associationDirection="None" /></bpmn:process><bpmn:process id="_0fa67bd5-e61d-5a9b-ab5c-fa0d97f5017c" name="Gobierno Regional Huanuco" isExecutable="false"><bpmn:laneSet id="_0fa67bd5-e61d-5a9b-ab5c-fa0d97f5017c_ls"><bpmn:lane id="_05b8f063-bb7f-5e1e-a8c1-f952a1741ba1" name="OACGD — Registro documentario"><bpmn:flowNodeRef>_e8e94572-a6fc-54ce-b272-8879f36240ec</bpmn:flowNodeRef><bpmn:flowNodeRef>_aaa3d8e8-9d