mentation>Adicional art. 194.2 b: informe en 5 dias calendario desde el dia siguiente de la anotacion</bpmn:documentation><bpmn:incoming>_7173bf20-7af0-5631-9756-6c19a44280ea</bpmn:incoming><bpmn:outgoing>_2be9f1f9-ff28-5088-aab5-ecda9d73c2bb</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="_a086c77b-645c-55b8-b363-26d5a8701e3c" name="¿Ratifica la necesidad?"><bpmn:incoming>_2be9f1f9-ff28-5088-aab5-ecda9d73c2bb</bpmn:incoming><bpmn:outgoing>_aed23d7a-2aac-5888-83c3-22e8cf632ffa</bpmn:outgoing><bpmn:outgoing>_5908c8f4-47be-50a2-bceb-058ce8f3d845</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="_2444cb94-4aa4-534c-8bc3-1cc2868d72a6" name="Necesidad ratificada y remitida"><bpmn:incoming>_aed23d7a-2aac-5888-83c3-22e8cf632ffa</bpmn:incoming><bpmn:messageEventDefinition id="_2444cb94-4aa4-534c-8bc3-1cc2868d72a6_def" /></bpmn:endEvent><bpmn:endEvent id="_7def99b4-58d1-5405-a94a-20225b6ffc0e" name="Necesidad no ratificada"><bpmn:incoming>_5908c8f4-47be-50a2-bceb-058ce8f3d845</bpmn:incoming></bpmn:endEvent><bpmn:startEvent id="_6c01b57b-a2a4-5a63-b0d8-3cf7b0bcd24d" name="Expediente para evaluacion recibido"><bpmn:outgoing>_e655ca01-565d-5b20-a4c6-df5511a94ab6</bpmn:outgoing><bpmn:messageEventDefinition id="_6c01b57b-a2a4-5a63-b0d8-3cf7b0bcd24d_def" /></bpmn:startEvent><bpmn:task id="_2265c28e-b8b1-55dc-b6c7-9d26535ff089" name="Evaluar expediente y emitir pronunciamiento"><bpmn:documentation>Contratista: 10 dias calendario desde el dia siguiente de presentacion; entidad: plazo correspondiente por precisar</bpmn:documentation><bpmn:incoming>_e655ca01-565d-5b20-a4c6-df5511a94ab6</bpmn:incoming><bpmn:outgoing>_9f0f2625-d8f1-5396-9344-6b156978f0a1</bpmn:outgoing></bpmn:task><bpmn:endEvent id="_4a157aa6-359f-5d8b-949a-54a5bbfde879" name="Opinion de supervision remitida"><bpmn:incoming>_9f0f2625-d8f1-5396-9344-6b156978f0a1</bpmn:incoming><bpmn:messageEventDefinition id="_4a157aa6-359f-5d8b-949a-54a5bbfde879_def" /></bpmn:endEvent><bpmn:sequenceFlow id="_282ea412-680c-