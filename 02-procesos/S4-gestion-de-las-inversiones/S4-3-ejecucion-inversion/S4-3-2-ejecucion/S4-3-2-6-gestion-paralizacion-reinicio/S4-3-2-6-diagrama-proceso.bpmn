on id="_62d5be5d-d75d-504d-aa17-9415ccee2a24" sourceRef="_ccacc64a-10ff-59f8-916f-7f362f9dc578" targetRef="_46a103a5-5fba-59b1-80af-3c93b6614767" associationDirection="None" /><bpmn:textAnnotation id="_7bfd225a-cee6-54c4-b398-ae44630ff27b"><bpmn:text>Se aplica el contrato; la resolucion queda diferida (DEC-061)</bpmn:text></bpmn:textAnnotation><bpmn:association id="_ff3851c3-7ff9-5ce1-884e-0a969a35e183" sourceRef="_b067ef06-5d5b-5736-a2ab-c6ef90b1f103" targetRef="_7bfd225a-cee6-54c4-b398-ae44630ff27b" associationDirection="None" /><bpmn:textAnnotation id="_63a14d73-3dce-57cc-8a16-c9dfd0932e1c"><bpmn:text>El contratista solicita la ampliacion conforme a S4.3.2.4</bpmn:text></bpmn:textAnnotation><bpmn:association id="_bdeead81-5ca3-546b-b8f8-abd811b7f965" sourceRef="_7b0d095a-d853-5ca3-b3c6-8cc194ab597b" targetRef="_63a14d73-3dce-57cc-8a16-c9dfd0932e1c" associationDirection="None" /><bpmn:textAnnotation id="_3f7bfdaa-6e14-580b-8b5f-4bff356c50cc"><bpmn:text>Contrato vigente (2.1 i); el contrato resuelto o nulo (2.1 ii) queda diferido</bpmn:text></bpmn:textAnnotation><bpmn:association id="_4ad1faa3-2e6d-58b2-98b0-a7dad4f91044" sourceRef="_7b43973d-d853-526e-abe0-2aa3cac47052" targetRef="_3f7bfdaa-6e14-580b-8b5f-4bff356c50cc" associationDirection="None" /><bpmn:textAnnotation id="_df73d6e0-01a7-55a8-9933-ad8edb454adf"><bpmn:text>Con el ultimo informe de avance, el cuaderno o un acta (3.2-3.4)</bpmn:text></bpmn:textAnnotation><bpmn:association id="_69512b57-f00f-5a42-9243-2afef31b8dba" sourceRef="_bdc4185c-f963-505c-ab41-9e5119b5e47e" targetRef="_df73d6e0-01a7-55a8-9933-ad8edb454adf" associationDirection="None" /><bpmn:textAnnotation id="_206bdf35-bcc8-577e-af48-26d93629fbe8"><bpmn:text>Elaborado por la UEI, el supervisor o inspector, o contratado; es vinculante</bpmn:text></bpmn:textAnnotation><bpmn:association id="_2341e84b-5f71-52e8-bf27-437a9f5cb6f9" sourceRef="_3c16d6c0-2742-58a5-81ec-8365237f7b72" targetRef="_206bdf35-bcc8-577e-af48-26d93629fbe8" associationDirection="None" /><bpmn:textAnnotation id="_cd2fa1bd-163a-5a59-9830-6b21b11e99c7"><bpmn:text>Publicacion en el portal en 5 dias habiles (9.1)</bpmn:text></bpmn:textAnnotation><bpmn:association id="_0001a569-5a99-5ab9-96ee-45d3a6784ae1" sourceRef="_0db00476-06e3-51fa-8891-eba06f08f2b0" targetRef="_cd2fa1bd-163a-5a59-9830-6b21b11e99c7" associationDirection="None" /><bpmn:textAnnotation id="_03086edb-95ee-54d8-af1b-1efc0654e690"><bpmn:text>Con las modificaciones contractuales que deriven del informe</bpmn:text></bpmn:textAnnotation><bpmn:association id="_32ebf93e-86d7-594e-a4c0-ebf79f9c524a" sourceRef="_b5210ec5-bdb7-54f4-99d8-908fafa84c3e" targetRef="_03086edb-95ee-54d8-af1b-1efc0654e690" associationDirection="None" /><bpmn:textAnnotation id="_d33ad530-61f2-5677-b811-9df882d79d5f"><bpmn:text>Registro en el Formato 12-B y en INFOBRAS (9.3)</bpmn:text></bpmn:textAnnotation><bpmn:association id="_f79d05ca-e4ae-52b6-918a-5dc9a899f747" sourceRef="_91421603-9df1-5ea1-a21b-68fee904bbbf" targetRef="_d33ad530-61f2-5677-b811-9df882d79d5f" associationDirection="None" /><bpmn:textAnnotation id="_426a25bf-f762-596b-bab5-4e865e6509bf"><bpmn:text>Remite al evento Contrato resuelto de S4.3.2</bpmn:text></bpmn:textAnnotation><bpmn:association id="_8ba0f004-814c-5037-91c8-1d8782679c87" sourceRef="_c0175dd2-5f33-5f47-b089-83ed673e761a" targetRef="_426a25bf-f762-596b-bab5-4e865e6509bf" associationDirection="None" /><bpmn:textAnnotation id="_db64ae43-21c9-51eb-a3b0-108d5a324117"><bpmn:text>Remite al evento Contrato resuelto de S4.3.2</bpmn:text></bpmn:textAnnotation><bpmn:association id="_0c3ce7a9-8d73-5a2d-8113-ac81eeb379fa" sourceRef="_a09830d4-0fb2-5ce3-b6a4-203e6b1873e7" targetRef="_db64ae43-21c9-51eb-a3b0-108d5a324117" associationDirection="None" /></bpmn:process><bpmndi:BPMNDiagram id="Diag_2ff18273" name="S4.3.2.6 Gestion de paralizacion y reinicio"><bpmndi:BPMNPlane id="Plane_2ff18273" bpmnElement="Collab_2ff18273"><bpmndi:BPMNShape id="_95a45b76-14f9-5e3a-95c3-505c9c2c051e_di" bpmnEleme