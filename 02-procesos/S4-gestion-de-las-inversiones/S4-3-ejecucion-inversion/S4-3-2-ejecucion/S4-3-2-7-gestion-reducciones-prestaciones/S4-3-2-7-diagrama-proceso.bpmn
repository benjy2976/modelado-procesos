d="_3b3ae3db-47a6-5888-b73e-327a00c4c9a4" name="No o no acreditado" sourceRef="_93f3ad95-4c87-5f04-9ea0-15f7d09ca16d" targetRef="_01f98bf3-80de-5525-a50c-28c38c56c678" /><bpmn:sequenceFlow id="_3335c761-e542-5d2b-83d9-9f70b927c44f" name="Si" sourceRef="_e7e64f1a-1a8a-5593-8d4d-51ca51ccc203" targetRef="_b1e6051b-22df-524a-bd42-dc9d0fc64239" /><bpmn:sequenceFlow id="_1af6190c-1371-59cb-9b5b-33456c4a8606" name="No" sourceRef="_e7e64f1a-1a8a-5593-8d4d-51ca51ccc203" targetRef="_b2254e5b-53a7-5fab-9ed3-f17d9c6ac7f2" /><bpmn:sequenceFlow id="_0c90abdd-bbed-51ab-aac3-74c7ed70ff4b" name="" sourceRef="_b1e6051b-22df-524a-bd42-dc9d0fc64239" targetRef="_d687b1b0-f68a-5ca4-9b5a-c73c856b84df" /><bpmn:sequenceFlow id="_c38c9cff-0a2e-5fbd-9256-3a7bcad6914b" name="" sourceRef="_d687b1b0-f68a-5ca4-9b5a-c73c856b84df" targetRef="_b2254e5b-53a7-5fab-9ed3-f17d9c6ac7f2" /><bpmn:sequenceFlow id="_1aa60a14-9d1c-5d88-83bb-c9f607cda2ba" name="" sourceRef="_b2254e5b-53a7-5fab-9ed3-f17d9c6ac7f2" targetRef="_7957377a-6a9e-5fd9-996c-f069704b9abc" /><bpmn:sequenceFlow id="_e0d9af1e-826c-559a-a6cd-4e12c9bb3bb3" name="" sourceRef="_7957377a-6a9e-5fd9-996c-f069704b9abc" targetRef="_655b0cab-6bdf-5567-a875-bb47126b6ff8" /><bpmn:sequenceFlow id="_f7ce23bd-a5cd-5b2f-ac15-b1497b22f66e" name="Si" sourceRef="_655b0cab-6bdf-5567-a875-bb47126b6ff8" targetRef="_baf1cf66-0b0f-524f-b5aa-1fc12ec4d1d3" /><bpmn:sequenceFlow id="_93c2c3ad-05a6-548e-8c1d-9f3565783790" name="No" sourceRef="_655b0cab-6bdf-5567-a875-bb47126b6ff8" targetRef="_1e50efca-15df-5713-bc9b-3bbbb12b7a40" /><bpmn:sequenceFlow id="_f351b729-e2c4-5846-b4ea-2db0bb5bbf72" name="" sourceRef="_baf1cf66-0b0f-524f-b5aa-1fc12ec4d1d3" targetRef="_156b2212-9edc-55dc-8dba-1dd8fe734c62" /><bpmn:textAnnotation id="_44b2c2e8-ed0e-59a6-8825-aea633641d60"><bpmn:text>Art. 109: finalidad, prestaciones no ejecutadas, divisibles y cuantificables; limite y oportunidad</bpmn:text></bpmn:textAnnotation><bpmn:association id="_0924ddb5-b19c-5620-8bfc-95a9fe3c91d0" sourceRef="_c71b69bf-5a89-5e12-9e98-f0178f0ae97b" targetRef="_44b2c2e8-ed0e-59a6-8825-aea633641d60" associationDirection="None" /><bpmn:textAnnotation id="_19c7b780-9de7-5ef1-adfc-a0099bcfe656"><bpmn:text>Condiciones a)-c) y limite del 25 % (art. 109.1)</bpmn:text></bpmn:textAnnotation><bpmn:association id="_84b3796b-2691-59b7-b537-8cd0128d6e35" sourceRef="_93f3ad95-4c87-5f04-9ea0-15f7d09ca16d" targetRef="_19c7b780-9de7-5ef1-adfc-a0099bcfe656" associationDirection="None" /><bpmn:textAnnotation id="_a6aff107-3894-5a91-a1a5-98b3fd43af83"><bpmn:text>Art. 109.1 d: obras y consultoria de obras, de corresponder</bpmn:text></bpmn:textAnnotation><bpmn:association id="_aaeff939-0f0e-5256-aa0c-ecf9b5d3636a" sourceRef="_e7e64f1a-1a8a-5593-8d4d-51ca51ccc203" targetRef="_a6aff107-3894-5a91-a1a5-98b3fd43af83" associationDirection="None" /><bpmn:textAnnotation id="_ff0b30a0-98b5-5d9b-a424-8114571773b8"><bpmn:text>Circuito interno y controles por acreditar; sin plazo adicional inventado</bpmn:text></bpmn:textAnnotation><bpmn:association id="_54fe9aa7-d7bd-551f-b536-4b57f2d9730b" sourceRef="_b2254e5b-53a7-5fab-9ed3-f17d9c6ac7f2" targetRef="_ff0b30a0-98b5-5d9b-a424-8114571773b8" associationDirection="None" /><bpmn:textAnnotation id="_879af411-a028-58e3-a024-d9d35e3ac070"><bpmn:text>La misma resolucion determina si se reduce el plazo (art. 109.2)</bpmn:text></bpmn:textAnnotation><bpmn:association id="_2abf4f9b-f340-5bbe-b8d2-ca19bcdf06fc" sourceRef="_7957377a-6a9e-5fd9-996c-f069704b9abc" targetRef="_879af411-a028-58e3-a024-d9d35e3ac070" associationDirection="None" /><bpmn:textAnnotation id="_96abbf0a-3dc6-532e-b12b-9333665f3dc9"><bpmn:text>Sin adenda (art. 109.3). Interfaz: el contratista puede pedir disminuir garantias (art. 117.3); adecuacion en 10 dias habiles (art. 117.4)</bpmn:text></bpmn:textAnnotation><bpmn:association id="_19f4a34b-220f-5be2-b567-cb9f9378a942" sourceRef="_baf1cf66-0b0f-524f-b5aa-1fc12ec4d1d3" targetRef="_96abbf0a-3dc6-532e-b12b-9333665f3dc9" associationDirection="None" /><bpmn:textAnnotation id="_1ba3932b-3ccd-5349-bf14-4fa59d51b903"><bpmn:text>No es denegacion de fondo; otros regimenes y variante sin supervisor pendientes</bpmn:text></bpmn:textAnnotation><bpmn:association id="_b640409f-e425-5bc8-a9c8-280999f68830" sourceRef="_01f98bf3-80de-5525-a50c-28c38c56c678" targetRef="_1ba3932b-3ccd-5349-bf14-4fa59d51b903" associationDirection="None" /></bpmn:process><bpmn:process id="_ae179a62-f4b0-5b1c-855a-e35ea7c34036" name="Supervisor o inspector de obra" isExecutable="false"><bpmn:laneSet id="_ae179a62-f4b0-5b1c-855a-e35ea7c34036_ls"><bpmn:lane id="_bd804f9b-db87-5295-a285-4c2e601d8aa4" name="Supervisor o inspector de obra, segun modalidad"><bpmn:flowNodeRef>_16e2b62d-cd25-540d-a450-7d63eb1a7216</bpmn:flowNodeRef><bpmn:flowNodeRef>_ec6985fb-5134-52af-b261-fc48c591c425</bpmn:flowNodeRef><bpmn:flowNodeRef>_5bb97381-ff30-5fae-85af-a4e8f2118d92</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="_16e2b62d-cd25-540d-a450-7d63eb1a7216" name="Solicitud de opinion recibida"><bpmn:outgoing>_4bd1f84d-c9c2-58a0-b400-6c546f6fb7d9</bpmn:outgoing><bpmn:messageEventDefinition id="_16e2b62d-cd25-540d-a450-7d63eb1a7216_def" /></bpmn:startEvent><bpmn:task id="_ec6985fb-5134-52af-b261-fc48c591c425" name="Emitir opinion sobre reduccion"><bpmn:incoming>_4bd1f84d-c9c2-58a0-b400-6c546f6fb7d9</bpmn:incoming><bpmn:outgoing>_c929a7f7-f9b8-53cb-8544-9ff912d4603a</bpmn:outgoing></bpmn:task><bpmn:endEvent id="_5bb97381-ff30-5fae-85af-a4e8f2118d92" name="Opinion remitida"><bpmn:incoming>_c929a7f7-f9b8-53cb-8544-9ff912d4603a</bpmn:incoming><bpmn:messageEventDefinition id="_5bb97381-ff30-5fae-85af-a4e8f2118d92_def" /></bpmn:endEvent><bpmn:sequenceFlow id="_4bd1f84d-c9c2-58a0-b400-6c546f6fb7d9" name="" sourceRef="_16e2b62d-cd25-540d-a450-7d63eb1a7216" targetRef="_ec6985fb-5134-52af-b261-fc48c591c425" /><bpmn:sequenceFlow id="_c929a7f7-f9b8-53cb-8544-9ff912d4603a" name="" sourceRef="_ec6985fb-5134-52af-b261-fc48c591c425" targetRef="_5bb97381-ff30-5fa