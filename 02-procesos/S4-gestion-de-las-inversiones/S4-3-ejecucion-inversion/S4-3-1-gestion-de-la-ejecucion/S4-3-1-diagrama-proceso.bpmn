tRef="_e41c752b-1a73-58be-b19c-ed9c4d15374e" /><bpmn:sequenceFlow id="_d4a20eb6-ab0d-506e-bc3a-7e8f73cbc32c" name="" sourceRef="_f739d1ce-2a06-5c28-a10a-ac9806a8905f" targetRef="_f1c3e4c4-d535-5514-9030-726aa93dc40f" /><bpmn:sequenceFlow id="_1177a708-4e49-5d8d-b894-f41cd495020d" name="" sourceRef="_f739d1ce-2a06-5c28-a10a-ac9806a8905f" targetRef="_e41c752b-1a73-58be-b19c-ed9c4d15374e" /><bpmn:sequenceFlow id="_4d79361f-899c-5348-bfeb-cc3f1bc801c2" name="" sourceRef="_f1c3e4c4-d535-5514-9030-726aa93dc40f" targetRef="_0bb81e5b-2974-511a-8961-3f7c154bba95" /><bpmn:dataObject id="_68c82171-6013-5507-a39d-f60ae1be937d_do" /><bpmn:dataObjectReference id="_68c82171-6013-5507-a39d-f60ae1be937d" name="Expediente técnico" dataObjectRef="_68c82171-6013-5507-a39d-f60ae1be937d_do" /><bpmn:dataObject id="_701e5ad8-60b8-5d24-9ce2-6f37cec26672_do" /><bpmn:dataObjectReference id="_701e5ad8-60b8-5d24-9ce2-6f37cec26672" name="Planificación" dataObjectRef="_701e5ad8-60b8-5d24-9ce2-6f37cec26672_do" /><bpmn:dataObject id="_0be54d5a-dfd1-5af5-9bf3-bf975c8eb575_do" /><bpmn:dataObjectReference id="_0be54d5a-dfd1-5af5-9bf3-bf975c8eb575" name="Términos de referencia o especificaciones técnicas" dataObjectRef="_0be54d5a-dfd1-5af5-9bf3-bf975c8eb575_do" /><bpmn:dataObject id="_7e04239e-5041-55da-8ff2-30cc832b4994_do" /><bpmn:dataObjectReference id="_7e04239e-5041-55da-8ff2-30cc832b4994" name="Información técnico y financiero para liquidación" dataObjectRef="_7e04239e-5041-55da-8ff2-30cc832b4994_do" /><bpmn:dataObject id="_182d1e04-1400-5f7b-ad6b-fbe76c5407e8_do" /><bpmn:dataObjectReference id="_182d1e04-1400-5f7b-ad6b-fbe76c5407e8" name="Informe de estado situacional" dataObjectRef="_182d1e04-1400-5f7b-ad6b-fbe76c5407e8_do" /><bpmn:textAnnotation id="_4fa107b3-b582-5d2c-8bfe-934ee3e98e77"><bpmn:text>Formato N.° 12-B. Envía a MEF / INFOBRAS: reporte de inversiones ejecutadas</bpmn:text></bpmn:textAnnotation><bpmn:association id="_8bc0bec3-c91f-5497-8bf2-f59f717761e9" sourceRef="_d918d40f-c01a-5291-970b-53b17a5ad678" targetRef="_4fa107b3-b582-5d2c-8bfe-934ee3e98e77" associationDirection="None" /><bpmn:textAnnotation id="_6d0606f5-4573-5023-b467-541df114d1c7"><bpmn:text>Envía a S2.1 Gestión Contable: expediente para pagos. Ruta por confirmar</bpmn:text></bpmn:textAnnotation><bpmn:association id="_96d69a47-4010-5252-8f21-20c946920133" sourceRef="_e6d1b334-c2a3-5db7-9c06-e5d7e4cd4188" targetRef="_6d0606f5-4573-5023-b467-541df114d1c7" associationDirection="None" /><bpmn:textAnnotation id="_27b8e555-ff44-5d3b-9b0b-bb3e727fb69e"><bpmn:text>Adicional, reducción, mayor metrado, plazo, suspensión o paralización. Actualiza la planificación y el seguimiento</bpmn:text></bpmn:textAnnotation><bpmn:association id="_1ead3781-8aac-5abd-b08c-c692c172910c" sourceRef="_014124b4-6298-5821-86b3-f7e3bc601134" targetRef="_27b8e555-ff44-5d3b-9b0b-bb3e727fb69e" associationDirection="None" /><bpmn:textAnnotation id="_eb8241c7-285e-5d1c-b5ee-a0d3074ef926"><bpmn:text>Envía a S3.1 el requerimiento y recibe de S3.2 lo contratado o adquirido</bpmn:text></bpmn:textAnnotation><bpmn:association id="_740a68e0-0cb1-5085-8142-5b84502de7c3" sourceRef="_ad03af61-fc80-57f2-a70e-b664c4f6fa9c" targetRef="_eb8241c7-285e-5d1c-b5ee-a0d3074ef926" associationDirection="None" /><bpmn:textAnnotation id="_0f54d695-67d8-533a-839b-bd00f9c08372"><bpmn:text>Inventario en el Banco de Inversiones e informe de estado situacional</bpmn:text></bpmn:textAnnotation><bpmn:association id="_05005d36-67ff-5262-8230-d18ee60bd31e" sourceRef="_820a65d7-8044-5e38-898e-3e44d85a5125" targetRef="_0f54d695-67d8-533a-839b-bd00f9c08372" associationDirection="None" /><bpmn:textAnnotation id="_ee62b948-c467-5de1-acc4-7c1dc2db8f2e"><bpmn:text>Si la obra requiere supervisor, solo mientras se contrata y hasta el límite de la valorización acumulada</bpmn:text></bpmn:textAnnotation><bpmn:association id="_310cf09d-c864-5243-9a28-b407fe461c7c" sourceRef="_31dd7cf8-88ea-51bd-9da5-26f64d29364b" targetRef="_ee62b948-c467-5de1-acc4-7c1dc2db8f2e" associationDirection="None" /><bpmn:textAnnotation id="_4405f558-f9f7-5d39-b8c0-e8a4d0bc9f3f"><bpmn:text>Contrata: art. 176.1 del Reglamento. Administración directa: num. 7.3.1 de la Directiva 017-2023-CG</bpmn:text></bpmn:textAnnotation><bpmn:association id="_60bde600-3b1f-5bc3-808d-fecee66b01cb" sourceRef="_0d7c2a05-d016-5773-a51b-80bec0384387" targetRef="_4405f558-f9f7-5d39-b8c0-e8a4d0bc9f3f" associationDirection="None" /><bpmn:textAnnotation id="_cbf7299a-22e4-53dc-b328-aa53142e57a9"><bpmn:text>Se cumple con los mensajes de S4.3.3: recepción o constatación concluida</bpmn:text></bpmn:textAnnotation><bpmn:association id="_4d2cabd9-5498-5120-8a79-1875266a87eb" sourceRef="_f237da3f-9700-5fa8-aa05-9c1f7a601240" targetRef="_cbf7299a-22e4-53dc-b328-aa53142e57a9" associationDirection="None" /><bpmn:group id="_25560dc4-deab-5fb8-8b5f-29883e2b442e" categoryValueRef="_94b69d39-7794-5493-97df-7b148dcde2da" /><bpmn:group id="_fc7823f1-30bf-5b77-83de-6f646a3270a5" categoryValueRef="_06379fbb-2ce7-5ec8-ab7a-e7e14ed5b545" /></bpmn:process><bpmndi:BPMNDiagram id="Diag_4325d137" name="S4.3.1 Gestión de la ejecución"><bpmndi:BPMNPlane id="Plane_4325d137" bpmnElement="Collab_4325d137"><bpmndi:BPMNShape id="_6b12ab20-3416-5c04-a64c-ffc5196e0292_di" bpmnElement="_6b12ab20-3416-5c04-a64c-ffc5196e0292" isHorizontal="true"><dc:Bounds x="20" y="449" width="3360" height="727" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_260e5357-5483-5744-8816-a58890fffd99_di" bpmnElement="_260e5357-5483-5744-8816-a58890fffd99" isHorizontal="true"><dc:Bounds x="85" y="40" width="3210" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_3c681db8-1f4e-5a34-8084-37f850515995_di" bpmnElement="_3c681db8-1f4e-5a34-8084-37f850515995" isHorizontal="true"><dc:Bounds x="174" y="196" width="312" height="60" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="_013fce16-7811-5e64-ad23-c688acbab353_di" bpmnElement="_013fce16-7811-5e64-ad23-c688acbab353" isHorizontal="true"><dc:Bounds x="516" y="196" width="333" height="6